# ----------------------------------------------------------------------
# BDIX Image Storage API - Root .htaccess
# ----------------------------------------------------------------------

# 1. Enable Authorization header in Apache / cPanel FastCGI
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header into PHP $_SERVER['HTTP_AUTHORIZATION']
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>

# 2. Disable ModSecurity / WAF rule inspection on uploads if allowed by host
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>

# 3. Disable directory listing
Options -Indexes

# 4. Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 5. Recommended upload settings (for mod_php, mod_php7, mod_php8)
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
