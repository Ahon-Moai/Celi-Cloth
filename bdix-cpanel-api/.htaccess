# ----------------------------------------------------------------------
# BDIX Image & Video Storage API - Root .htaccess
# ----------------------------------------------------------------------

# 1. Enable Authorization header in Apache / cPanel FastCGI
CGIPassAuth On
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header into PHP $_SERVER['HTTP_AUTHORIZATION']
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>

# 2. Disable ModSecurity / WAF rule inspection on uploads if allowed by host
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>

# 3. Disable directory listing
Options -Indexes

# 4. Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 5. Video & Image MIME Types Configuration
<IfModule mod_mime.c>
    AddType video/mp4 .mp4 .m4v
    AddType video/webm .webm
    AddType video/quicktime .mov
    AddType video/ogg .ogv
</IfModule>

# 6. Recommended upload settings for up to 100MB videos (if supported by cPanel Apache handler)
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 105M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
