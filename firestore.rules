rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && (request.auth.token.email == 'mimpy124ahon124@gmail.com' || request.auth.token.email == 'feliciteclothing@gmail.com') && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Messages Collection
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt'])
          && data.name is string && data.name.size() <= 200
          && data.email is string && data.email.size() <= 200
          && data.subject is string && data.subject.size() <= 500
          && data.message is string && data.message.size() <= 5000
          && data.status in ['new', 'read', 'replied', 'trash'];
      }
      allow create: if isValidMessage(incoming());
      allow read, list, update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['customerInfo', 'items', 'totalAmount', 'deliveryCharge', 'grandTotal', 'status', 'paymentMethod', 'createdAt'])
          && data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled']
          && data.paymentMethod in ['COD', 'WhatsApp']
          && data.totalAmount is number
          && data.items is list
          && data.customerInfo is map;
      }
      allow create: if isValidOrder(incoming());
      allow read, list, update, delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
  }
}
